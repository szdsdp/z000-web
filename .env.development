# 开发环境配置
ENV = 'development'

# 系统代码
VUE_APP_SYS_CODE = 'Z000'
VUE_APP_SYS_NAME = '微应用模版'

# 前端端口号
VUE_APP_WEB_PORT = '89'

# 管理系统/开发环境
VUE_APP_BASE_API = '/gateapi'
VUE_APP_BASE_API_CORE = '/gateapi/core'


# 后端URL地址
VUE_APP_JAVA_URL_CORE = 'http://192.168.101.172:9000'
VUE_APP_JAVA_URL_MICRO = 'http://192.168.101.172:9000'


# 存储模式
VUE_APP_STORE_MODE = 'true'
